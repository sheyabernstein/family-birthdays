COMPOSE_PROJECT_NAME=family-birthdays

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_BASE_URL=http://127.0.0.1:8000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=family_birthdays
POSTGRES_USER=family_birthdays
POSTGRES_PASSWORD=family_birthdays
POSTGRES_SSLMODE=prefer

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=family_birthdays

FAMILY_TIME_ZONE=Europe/London
DIASPORA=True

EMAIL_SENDING_DOMAIN=localhost
# Mailpit (see docker-compose.dev.yml) - sent emails show up at
# http://localhost:8025 instead of just being logged to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

SMS_BACKEND=notifications.sms.ConsoleSmsBackend
# Only required when SMS_BACKEND=notifications.sms.SnsSmsBackend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_REGION=

LOG_LEVEL=DEBUG

# --- Observability ---
# OTel is always on (spans are always recorded); leaving OTEL_ENDPOINT
# blank just means no real OTLP exporter is attached (no separate
# OTEL_ENABLED flag - see config/settings.py). Set it to
# http://tempo:4317 once docker-compose.observability.yml is also up (see
# that file's own header comment). Same for SENTRY_DSN below - blank means
# Sentry stays off.
OTEL_SERVICE_NAME=family-birthdays
OTEL_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_HEADERS=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Blank/unset defaults to true - set false to stop mirroring OTel spans
# into Sentry as transactions (exceptions still get reported either way,
# just without a cross-reference to their matching Tempo trace).
SENTRY_TRACES_ENABLED=

METRICS_NAMESPACE=family_birthdays
PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc
