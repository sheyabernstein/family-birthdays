# Templated with sed at container start (see docker-compose.observability.yml's
# prometheus service command) - Prometheus itself has no env-var
# interpolation, so the __NAMESPACE__ placeholder is substituted for
# $COMPOSE_PROJECT_NAME before this file is handed to the real binary. A
# plain, dollar-sign-free placeholder is deliberate - both Compose's own
# ${VAR} interpolation (which runs on this whole compose stack before any
# container ever starts) and sed's own pattern syntax use `$`, so anything
# involving a literal `${...}` here gets mangled by one or the other before
# it can do its job; __NAMESPACE__ collides with neither. Every scraped
# series gets a `namespace` label this way, matching the k8s-namespace
# dashboard variable prod's Grafana dashboards key off of - so the same
# dashboard JSON works unmodified against local and prod data.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: family-birthdays-web
    static_configs:
      - targets: ["web:9090"]
    relabel_configs:
      - target_label: namespace
        replacement: "__NAMESPACE__"
      - target_label: service
        replacement: web

  - job_name: family-birthdays-worker
    static_configs:
      - targets: ["worker:9090"]
    relabel_configs:
      - target_label: namespace
        replacement: "__NAMESPACE__"
      - target_label: service
        replacement: worker
